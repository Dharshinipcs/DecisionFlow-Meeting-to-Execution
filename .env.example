# GEMINI_API_KEY: Required for Gemini AI API calls (meeting extraction, conflict reasoning, embeddings, Ask Memory, digests).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# GEMINI_MODEL: Optional override for the Gemini model (defaults to gemini-4-hydrogen)
GEMINI_MODEL=gemini-4-hydrogen

# GEMINI_FALLBACK_MODEL: Optional fallback model when primary hits 429 quota/503/timeout (defaults to gemini-3.1-flash-lite)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# APP_URL: The URL where this applet is hosted.
APP_URL=

# GitHub Issues Integration (server-side only; required for real GitHub Issue creation)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Local SQLite database path (defaults to ./data/decisionflow.db)
DATABASE_PATH=

# Optional reference Supabase / PostgreSQL configuration for external deployments
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

